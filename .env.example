# Shared API key — frontend must send this on every request:
#   Header: x-api-key: <value>
#   or:     Authorization: Bearer <value>
# Generate one: openssl rand -hex 32
API_SECRET_KEY=

# AWS S3 (required when using S3 upload service)
# Must match your S3 bucket region (rockyrealestate-website is eu-north-1)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=rockyrealestate-website

# Optional S3 upload size limits (bytes). Defaults: image 5MB, video 100MB, pdf 10MB, cv 10MB
# AWS_S3_MAX_IMAGE_SIZE=5242880
# AWS_S3_MAX_VIDEO_SIZE=104857600
# AWS_S3_MAX_PDF_SIZE=10485760
# AWS_S3_MAX_CV_SIZE=10485760

# Zapier Catch Hook (optional). If unset, lead creation still succeeds; webhook is skipped.
# Property enquiries use this hook and include source: "Property Enquiry"
# plus propertyRefNo, name, phone, email, message, and isHeadOffice.
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXX/YYYYY/

# Public API base URL (optional). Used for cvUrl / cvDownloadUrl in career applications.
# Example: https://backend.rockyrealestate.com
PUBLIC_BASE_URL=

# Google Apps Script web app URL for career applications → Google Sheets (optional).
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwcXSWP1o5YPqc6WY2ENjxcDI6JaWIxULcxYjXJ77qpadPWkKyShpYJ3iRd0haJk4RAQw/exec

# Google Apps Script web app URL for Jewel Tower leads → Google Sheets (optional).
# GOOGLE_SHEETS_JEWEL_TOWER_LEAD_URL=https://script.google.com/macros/s/XXXX/exec

# Google Apps Script web app URL for landing page leads → Google Sheets (optional).
# GOOGLE_SHEETS_LANDING_PAGE_LEAD_URL=https://script.google.com/macros/s/XXXX/exec

# Zapier Catch Hook for Jewel Tower leads (optional).
# JEWEL_TOWER_ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/XXXXX/YYYYY/

# TeamTailor API (required for /api/teamtailor endpoints)
# Authorization header format: Token token=<TEAMTAILOR_API_TOKEN>
# Job sync keeps using TEAMTAILOR_API_TOKEN, TEAMTAILOR_API_BASE_URL, and TEAMTAILOR_API_VERSION.
TEAMTAILOR_API_TOKEN=
TEAMTAILOR_API_VERSION=20240404
TEAMTAILOR_API_BASE_URL=https://api.teamtailor.com/v1
# Admin Read/Write key (Rocky Careers Admin API). Used only by POST /api/teamtailor/apply.
# Leave the jobs token above unchanged. Optional alias: TEAMTAILOR_API_KEY.
TEAMTAILOR_ADMIN_API_TOKEN=
# Optional alias for the base URL: TEAMTAILOR_API_URL.
# Apply calls use this version and do not change the job-sync version above.
# The key needs read/write access to candidates, uploads, and job applications.
TEAMTAILOR_APPLY_API_VERSION=20240904
# Short-lived private CV URL Teamtailor fetches. Clamped between 60 and 900 seconds.
# TEAMTAILOR_RESUME_URL_TTL_SECONDS=600
# Auto-sync jobs into MongoDB (adds / updates / removes). Default every 5 minutes.
TEAMTAILOR_SYNC_ENABLED=true
TEAMTAILOR_SYNC_CRON="*/5 * * * *"
TEAMTAILOR_SYNC_ON_START=true
# TEAMTAILOR_SYNC_TZ=Asia/Dubai

# Resend email for POST /api/relocation-guide.
# RELOCATION_GUIDE_URL is the https S3 or CloudFront PDF link. It is never taken from the request.
# Relocation enquiries are not sent to Teamtailor. That integration only creates job candidates,
# and candidate records have no location or country field to reuse.
RESEND_API_KEY=
RESEND_FROM_EMAIL=relocation@rockyrealestate.com
RESEND_FROM_NAME="Rocky Real Estate"
RELOCATION_GUIDE_URL=
# Temporary public placeholders. Replace with the hosted Rocky logo and brochure images.
RELOCATION_EMAIL_LOGO_URL=https://placehold.co/240x80/1B2A3B/FFFFFF.png?text=ROCKY+REAL+ESTATE
RELOCATION_EMAIL_BROCHURE_URL=https://placehold.co/600x300/E9E8E2/1B2A3B.png?text=Dubai+Relocation+Guide

# Google Business Profile OAuth (company reviews integration — not website login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://backend.rockyrealestate.com/auth/google/callback
# Optional explicit account/location from GET /api/reviews/google/business-profiles.
# Leave unset to auto-select when Google returns exactly one of each.
# GOOGLE_BUSINESS_ACCOUNT_NAME=
# GOOGLE_BUSINESS_LOCATION_NAME=
# Review sync (MongoDB ← Google). Default every 30 minutes.
GOOGLE_REVIEWS_SYNC_ENABLED=true
GOOGLE_REVIEWS_SYNC_CRON="*/30 * * * *"
GOOGLE_REVIEWS_SYNC_ON_START=true
# GOOGLE_REVIEWS_SYNC_TZ=Asia/Dubai
